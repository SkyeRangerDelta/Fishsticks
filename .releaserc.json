{
  "branches": [
    "master",
    {
      "name": "Experimental",
      "prerelease": true,
      "channel": "exp"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "docs",     "scope": "README", "release": "patch" },
          { "type": "style",                       "release": "patch" }
        ],
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING CHANGES"]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat",     "section": "Features" },
            { "type": "feature",  "section": "Features" },
            { "type": "fix",      "section": "Bug Fixes" },
            { "type": "perf",     "section": "Performance Improvements" },
            { "type": "revert",   "section": "Reverts" },
            { "type": "chore",    "scope": "sync",    "section": "Chores", "effect": "hidden" },
            { "type": "chore",    "scope": "release", "section": "Chores", "effect": "hidden" },
            { "type": "chore",    "section": "Chores",                 "effect": "changelog" },
            { "type": "docs",     "section": "Documentation",          "effect": "hidden" },
            { "type": "style",    "section": "Styles",                 "effect": "hidden" },
            { "type": "refactor", "section": "Code Refactoring",       "effect": "changelog" },
            { "type": "test",     "section": "Tests",                  "effect": "hidden" },
            { "type": "build",    "section": "Build System",           "effect": "hidden" },
            { "type": "ci",       "section": "Continuous Integration", "effect": "changelog" }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "|| v${version} Changelog ||"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    ["@semantic-release/git", {
      "assets": [
        "package.json",
        "package-lock.json",
        "README.md",
        "CHANGELOG.md"
      ],
      "message": "Chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    "@semantic-release/github"
  ],
  "tagFormat": "v${version}",
  "GIT_AUTHOR_NAME": "SkyeRangerDelta",
  "GIT_AUTHOR_EMAIL": "skyerangerdelta@pldyn.net",
  "GIT_COMMITTER_NAME": "SkyeRangerDelta",
  "GIT_COMMITTER_EMAIL": "skyerangerdelta@pldyn.net"
}
